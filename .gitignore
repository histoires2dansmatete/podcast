# Résultat généré par `npm run build` : Cloudflare le reconstruit.
dist/

# Dépendances (aucune nécessaire dans la version actuelle).
node_modules/

# Secrets éventuels : ne jamais les committer.
.env
.env.*
!.env.example

# Fichiers des systèmes / éditeurs
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.log

# Pages individuelles régénérées par npm run generate:stories
site/histoires/

# Export WordPress privé (ne jamais committer le XML brut)
*.xml
!site/sitemap.xml

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self'; media-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/config.js
  Cache-Control: no-cache

/admin/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

/api/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

/data/histoires.json
  Cache-Control: no-store

/histoires/*
  Cache-Control: no-store

/noel/*
  Cache-Control: private, no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/assets/audio/noel/*
  Cache-Control: private, no-store, max-age=0
